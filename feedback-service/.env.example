# Copy to .env and fill in the blanks; the service loads it on startup.

# Password for the admin page (results and phone calls)
FEEDBACK_ADMIN_TOKEN=

# MongoDB. Feedback forms are stored in the `feedbacks` collection of this database.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=dotai_labs

# --- Conversation model for phone calls ---
# Which provider runs the conversation: openai or claude
FEEDBACK_AGENT_PROVIDER=openai
# Only the key for the provider chosen above is needed
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: override the model (defaults: openai gpt-6.1-terra, claude claude-opus-5-5)
#FEEDBACK_AGENT_MODEL=
# Optional: how hard the model thinks per turn (defaults: openai none, claude low).
# With openai, leave this unset: the API rejects any value other than none.
#FEEDBACK_AGENT_EFFORT=

# --- Twilio ---
TWILIO_ACCOUNT_SID=
# Auth Token from the Twilio console. Always required: it verifies that incoming requests are from Twilio.
TWILIO_AUTH_TOKEN=
# A voice-capable Twilio number you own, in +countrycode form
TWILIO_FROM_NUMBER=
# Optional: an API key (SK...) and its secret. When both are set, calls are placed with these
# instead of the Auth Token.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Public https address of this service, reachable by Twilio (e.g. your ngrok URL), no trailing slash
PUBLIC_BASE_URL=

# --- Optional call settings ---
# Speech language for the call, e.g. en-IN (Twilio's default is used when unset)
#CALL_LANGUAGE=en-IN
# Prefix for CSV phone numbers written without a country code
#CALL_DEFAULT_COUNTRY_CODE=+91
# How many calls may be in progress at once
#CALL_MAX_CONCURRENT=5
